STORAGE_MODE=postgres
DATABASE_URL=postgres://bookway:bookway-local-only@127.0.0.1:5432/bookway
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_PER_MINUTE=600
HTTP_CONNECT_TIMEOUT_MS=500
HTTP_REQUEST_TIMEOUT_MS=2000

KAFKA_BROKERS=127.0.0.1:19092
KAFKA_OUTBOX_TOPIC=bookway.domain-events.v1
OUTBOX_BATCH_SIZE=100
REMINDER_DISPATCH_BATCH_SIZE=100
PUSH_DELIVERY_GATEWAY_URL=http://127.0.0.1:8110/v1/push/deliveries
PUSH_DELIVERY_BATCH_SIZE=100
PUSH_DELIVERY_LEASE_SECONDS=120
PUSH_DELIVERY_MAX_ATTEMPTS=10
COMMUNITY_NOTIFICATION_BATCH_SIZE=100
COMMUNITY_NOTIFICATION_LEASE_SECONDS=30
COMMUNITY_NOTIFICATION_MAX_ATTEMPTS=10
COMMUNITY_NOTIFICATION_CONCURRENCY=16
COMMUNITY_NOTIFICATION_REQUEST_TIMEOUT_MS=3000

BBS_GRPC_URL=http://127.0.0.1:18002
ROUTE_RECONCILE_BATCH_SIZE=100
ROUTE_RECONCILE_CONCURRENCY=16
ROUTE_RECONCILE_LEASE_SECONDS=30
ROUTE_RECONCILE_REQUEST_TIMEOUT_MS=3000
APPEAL_NOTIFICATION_BATCH_SIZE=100
APPEAL_NOTIFICATION_CONCURRENCY=16
APPEAL_NOTIFICATION_LEASE_SECONDS=30
APPEAL_NOTIFICATION_REQUEST_TIMEOUT_MS=3000
REPORT_RESTRICTION_BATCH_SIZE=100
REPORT_RESTRICTION_CONCURRENCY=16
REPORT_RESTRICTION_LEASE_SECONDS=30
REPORT_RESTRICTION_REQUEST_TIMEOUT_MS=3000
BBS_LINK_GRPC_URL=http://127.0.0.1:18004
GROWTH_GRPC_URL=http://127.0.0.1:8081
ACCOUNT_GRPC_URL=http://127.0.0.1:8094

OPENSEARCH_URL=http://127.0.0.1:9200
# Deprecated read/write fallback for existing local deployments.
OPENSEARCH_INDEX=bookway-content-v1
# Production alias publication uses these explicit names after the initial alias switch.
# OPENSEARCH_READ_ALIAS=bookway-content
# OPENSEARCH_WRITE_INDEX=bookway-content-v1
# During a full rebuild, keep the active write index above and dual-write to the candidate.
# OPENSEARCH_SHADOW_WRITE_INDEX=bookway-content-v2
# OPENSEARCH_REBUILD_INDEX=bookway-content-v2
# Read-only physical-index reconciliation. Samples contain internal content IDs; leave disabled normally.
# OPENSEARCH_RECONCILE_INDEX=bookway-content-v2
# SEARCH_INDEX_RECONCILE_BATCH_SIZE=500
# SEARCH_INDEX_RECONCILE_AFTER_ID=last-verified-content-id
# SEARCH_INDEX_RECONCILE_SAMPLE_LIMIT=0
# SEARCH_INDEX_RECONCILE_RUN_ID=00000000-0000-0000-0000-000000000000
# SEARCH_INDEX_RECONCILE_LEASE_SECONDS=600
# Default is report-only. Dead-letter recovery additionally requires a named operator and reason.
# SEARCH_INDEX_RECOVERY_ACTION=report
# SEARCH_INDEX_RECOVERY_ACTOR=oncall@example.com
# SEARCH_INDEX_RECOVERY_REASON=OpenSearch cluster restored

S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=bookway-media
S3_REGION=us-east-1
S3_ACCESS_KEY=bookway-local
S3_SECRET_KEY=bookway-local-only
CDN_BASE_URL=http://127.0.0.1:9000/bookway-media
MEDIA_PROXY_UPLOAD=false

CONTENT_AUDIT_GRPC_URL=http://127.0.0.1:8092
FEEDBACK_GRPC_URL=http://127.0.0.1:8104
FEATURE_MAIN_GRPC_URL=http://127.0.0.1:8093
RECOMMEND_RECALL_GRPC_URL=http://127.0.0.1:8095
RECALL_SOURCE_BLEND=balanced-v1
RECOMMEND_RANK_GRPC_URL=http://127.0.0.1:8096
MEDIA_GRPC_URL=http://127.0.0.1:18091
AD_CENTER_GRPC_URL=http://127.0.0.1:8097
AD_RECALL_GRPC_URL=http://127.0.0.1:8098
AD_RANK_GRPC_URL=http://127.0.0.1:8099
AD_MAIN_GRPC_URL=http://127.0.0.1:8100
MALL_GRPC_URL=http://127.0.0.1:8101
MALL_INVENTORY_GRPC_URL=http://127.0.0.1:8102
MALL_ORDER_GRPC_URL=http://127.0.0.1:8103
MALL_RESERVATION_TTL_SECONDS=900
MALL_PAYMENT_TTL_SECONDS=900
MALL_ORDER_EXPIRER_BATCH_SIZE=100
MALL_ORDER_EXPIRER_IDLE_MS=1000
MALL_INVENTORY_SWEEPER_BATCH_SIZE=100
MALL_INVENTORY_SWEEPER_IDLE_MS=1000

SERVICE_AUTH_REQUIRED=true
SERVICE_AUTH_TOKEN=replace-with-at-least-32-random-bytes
AUTH_REQUIRED=true
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:19006,http://localhost:19006

RUST_LOG=info
