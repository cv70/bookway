[Service]
Type=oneshot
User=bookway
WorkingDirectory=/opt/bookway/backend
EnvironmentFile=/etc/bookway/backend.env
# Observational recommendation quality snapshot over verified, non-degraded
# exposures with completed label windows.
[Unit]
Description=Bookway recommendation quality evaluation
After=network-online.target

[Service]
ExecStart=/opt/bookway/backend/target/release/bookway-recommendation-evaluator
