[Service]
Type=oneshot
User=bookway
WorkingDirectory=/opt/bookway/backend
EnvironmentFile=/etc/bookway/backend.env
# Observational search quality snapshot. It never activates rewrite
# versions; sample-thin snapshots are rejected by the job itself.
[Unit]
Description=Bookway search quality evaluation
After=network-online.target

[Service]
ExecStart=/opt/bookway/backend/target/release/bookway-search-evaluator
