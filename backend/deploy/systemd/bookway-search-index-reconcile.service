[Service]
Type=oneshot
User=bookway
WorkingDirectory=/opt/bookway/backend
EnvironmentFile=/etc/bookway/backend.env
# Read-only comparison of physical indices against content facts. A run only
# counts as healthy evidence when it completes fully with an empty outbox.
[Unit]
Description=Bookway search index reconciliation
After=bookway-search-indexer.service

[Service]
ExecStart=/opt/bookway/backend/target/release/bookway-search-index-reconcile
